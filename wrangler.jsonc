// vitrine.software on Cloudflare Workers: the built site (dist) as static assets - no Worker code.
{
  "name": "vitrine-software",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "vitrine.software", "custom_domain": true },
    { "pattern": "www.vitrine.software", "custom_domain": true } // (the same pages: their canonical links name vitrine.software)
  ]
}
