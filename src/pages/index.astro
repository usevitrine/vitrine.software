---
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Frame from '../components/Frame.astro';
import Icon from '../components/Icon.astro';
import Email from '../components/Email.astro';
import { Image } from 'astro:assets';
import { REPO, PLUGINS_REPO, RELEASES, latestRelease } from '../lib/site';
// (taken by the app repo's tools/siteshots from its demo library: public-domain art, Blender open-movie clips, McCay's comics)
import library from '../assets/shots/desktop-library.png';
import search from '../assets/shots/desktop-search.png';
import viewer from '../assets/shots/desktop-viewer.png';
import reader from '../assets/shots/desktop-reader.png';
import phoneLibrary from '../assets/shots/phone-library.png';
import phoneSearch from '../assets/shots/phone-search.png';
import phoneVideo from '../assets/shots/phone-video.png';
import phoneComics from '../assets/shots/phone-comics.png';

// The Downloads mock-up's new files: thumbnails from the demo library (woodblock prints and landscapes, like its searches).
const newFiles = Object.values(import.meta.glob<{ default: ImageMetadata }>('../assets/new/*.webp', { eager: true })).map((m) => m.default);

const release = await latestRelease();
const windows = release.windows ?? RELEASES;

const title = 'Vitrine - a fast, self-hosted media library with a built-in downloader';
const description =
  'Vitrine is a free, open-source, self-hosted media library for images and videos: booru-style tag search in milliseconds, a built-in gallery downloader with subscriptions, comics, and one web app for phone and desktop. A lean Hydrus alternative for Docker and Windows.';

// The hero's wall of thumbnails: shapes in the app's colors that settle into Rows as the page opens.
const hues = ['--mauve', '--pink', '--peach', '--blue', '--teal', '--lavender', '--green', '--yellow', '--red'];
let seed = 7;
const rnd = () => (seed = (seed * 9301 + 49297) % 233280) / 233280;
const rows = Array.from({ length: 6 }, () =>
  Array.from({ length: 7 }, () => ({
    ratio: [0.7, 0.8, 1, 1.33, 1.5, 0.66, 1.78][Math.floor(rnd() * 7)],
    a: hues[Math.floor(rnd() * hues.length)],
    b: hues[Math.floor(rnd() * hues.length)],
    x: Math.round((rnd() - 0.5) * 260),
    y: Math.round((rnd() - 0.5) * 200),
    r: Math.round((rnd() - 0.5) * 40),
    d: Math.round(rnd() * 500),
  })),
);

const faqs = [
  {
    q: 'Is Vitrine free?',
    a: 'Yes. Vitrine is free and open source (AGPL-3.0). There is no account, no subscription and no cloud: it runs on your own computer or server.',
  },
  {
    q: 'What do I need to run it?',
    a: 'A Windows 10 or 11 PC (the installer brings everything with it), Docker on a Linux server or NAS, or the program for Linux, macOS or Windows. Your phone and other computers open it in the browser.',
  },
  {
    q: 'How is it different from Hydrus?',
    a: 'Hydrus is a powerful desktop program. Vitrine is built for using your library through a browser - on a phone as much as on a desktop - with the downloader, the library and the web app in one program, so there are no gaps between separate tools to patch over.',
  },
  {
    q: 'Can I add the files I already have?',
    a: 'Yes. The vitrine import command adds files and folders to the library (the originals are copied, never moved), and each file is stored only once.',
  },
  {
    q: 'Does it phone home?',
    a: 'No tracking, no analytics. Vitrine checks GitHub once a day for a new version, which you can switch off, and otherwise only talks to the sites you download from.',
  },
  {
    q: 'Which sites can it download from?',
    a: 'Sites come as plugins: booru-style image boards (Gelbooru, Danbooru and Shimmie sites), gallery sites and Mastodon. Safebooru is built in; more are one click away in Settings, and you can write your own.',
  },
];

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Vitrine',
    description,
    url: 'https://vitrine.software',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Windows, Linux, macOS, Docker',
    license: 'https://www.gnu.org/licenses/agpl-3.0.html',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    ...(release.version ? { softwareVersion: release.version, datePublished: release.date } : {}),
    downloadUrl: RELEASES,
    codeRepository: REPO,
    screenshot: 'https://vitrine.software/social.png',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];

const more = [
  { icon: 'layers', title: 'Duplicates', text: 'Finds pictures that look alike and lets you keep the better one, side by side.' },
  { icon: 'undo', title: 'Trash with undo', text: 'Deleted by mistake? Undo, or restore it from the trash later.' },
  { icon: 'tags', title: 'Tags that stay tidy', text: 'Parents, siblings and namespaces. Tags refreshed from their sites now and then.' },
  { icon: 'bell', title: 'Push notifications', text: 'New files from your subscriptions, on your phone, without the sites named.' },
  { icon: 'disk', title: 'Backups', text: 'A daily backup of the library database, restored in two clicks.' },
  { icon: 'terminal', title: 'Command line', text: 'status, queue, subs, logs: the running server, from your terminal.' },
  { icon: 'refresh', title: 'Updates in the app', text: 'Told when a new version is out, installed with one button.' },
  { icon: 'shield', title: 'Yours', text: 'One login, your files on your disks. Nothing leaves unless you download it.' },
] as const;
---

<Base title={title} description={description} jsonld={jsonld}>
  <!-- Hero -->
  <section class="hero">
    <div class="wall" aria-hidden="true">
      {
        rows.map((row) => (
          <div class="wall-row">
            {row.map((t) => (
              <i style={`flex-grow:${t.ratio};aspect-ratio:${t.ratio};--a:var(${t.a});--b:var(${t.b});--x:${t.x}px;--y:${t.y}px;--r:${t.r}deg;--d:${t.d}ms`} />
            ))}
          </div>
        ))
      }
    </div>
    <div class="wrap hero-text">
      <p class="eyebrow rise" style="--i:0"><Icon name="sparkles" size={15} /> Free · Open source · Self-hosted</p>
      <h1 class="rise" style="--i:1">Your media library.<br /><span class="grad">Fast, self-hosted, yours.</span></h1>
      <p class="lead rise" style="--i:2">
        Pictures and videos with booru-style tags, searched in milliseconds. A downloader built in. One app for your phone and your desktop.
      </p>
      <div class="cta rise" style="--i:3">
        <a class="btn" href="/demo"><Icon name="play" size={18} /> Try the demo</a>
        <a class="btn quiet" href="#install"><Icon name="download" size={18} /> Download</a>
      </div>
      <p class="aside rise" style="--i:4">No cloud. No account. No one judging your 40,000 bookmarks.</p>
    </div>
    <div class="wrap hero-shots">
      <Frame src={library} alt="Vitrine's library in Rows: a search bar over a justified grid of paintings, prints and clips" eager class="hero-laptop" />
      <Frame src={phoneLibrary} kind="phone" alt="Vitrine on a phone: the library in Rows" eager class="hero-phone" />
    </div>
  </section>

  <!-- Numbers -->
  <section class="wrap numbers" aria-label="Vitrine in numbers">
    <div class="num" data-reveal style="--i:0"><strong data-count="1000000">1,000,000</strong><span>files, searched in milliseconds</span></div>
    <div class="num" data-reveal style="--i:1"><strong>0</strong><span>accounts, clouds or trackers</span></div>
    <div class="num" data-reveal style="--i:2"><strong>1</strong><span>program: library, downloader and app</span></div>
    <p class="aside" data-reveal style="--i:3">We measured. You blink slowly.</p>
  </section>

  <!-- Search -->
  <section id="features" class="wrap feature">
    <div class="copy" data-reveal>
      <p class="eyebrow"><Icon name="search" size={15} /> Search</p>
      <h2>Find anything in the time it takes to blink.</h2>
      <p class="lead">
        Booru-style search with chips: tags, exclusions, OR groups, wildcards and filters for type, size, date and more. Suggestions as you type, saved
        searches, and results in milliseconds even at a million files.
      </p>
      <div class="searchbar" aria-hidden="true">
        <Icon name="search" size={16} />
        <span class="chip c1">landscape</span>
        <span class="chip c2 neg">-night</span>
        <span class="chip c3 sys">system:type=image</span>
        <span class="caret"></span>
      </div>
    </div>
    <div class="shot" data-reveal style="--i:1">
      <Frame src={search} alt="A search for woodblock prints without portraits: two chips in the search bar over a grid of Japanese prints" />
    </div>
  </section>

  <!-- Viewer -->
  <section class="wrap feature flip">
    <div class="copy" data-reveal>
      <p class="eyebrow"><Icon name="images" size={15} /> Viewer</p>
      <h2>Every file, with everything it knows.</h2>
      <p class="lead">
        Swipe through your results, pinch to zoom, scrub videos with a player made for it. The details show where a file came from, its sources and its
        tags by kind, and a tap on a tag searches for it.
      </p>
      <ul class="ticks">
        <li><Icon name="check" size={16} /> Pictures, GIFs and videos: JPEG, PNG, WebP, AVIF, MP4, WebM, MKV and more</li>
        <li><Icon name="check" size={16} /> Favorites, tags edited in place, the trash one swipe away</li>
        <li><Icon name="check" size={16} /> Huge pictures that don't crash your phone</li>
      </ul>
    </div>
    <div class="shot" data-reveal style="--i:1">
      <Frame src={viewer} alt="The viewer with its details: where the file came from, its sources and its tags by kind" />
    </div>
  </section>

  <!-- Downloader -->
  <section class="wrap feature">
    <div class="copy" data-reveal>
      <p class="eyebrow"><Icon name="download" size={15} /> Downloader</p>
      <h2>Subscriptions that actually finish.</h2>
      <p class="lead">
        Download a search once, or subscribe and get what's new on its own. Vitrine resumes exactly where it stopped, never downloads the same file twice,
        respects each site's limits and checks every file against the site's own checksum.
      </p>
      <p class="aside">Turn it off and on again. It picks up where it was. We checked.</p>
    </div>
    <div class="dlmock glow" data-reveal style="--i:1" aria-hidden="true">
      <div class="dl-head"><strong>Downloads</strong><span class="pill">3 going</span></div>
      <div class="dl-stack">
        {
          [
            { q: 'landscape', kind: 'Sub', n: '57/120', delay: '0s' },
            { q: 'blue_sky', kind: 'Initial', n: '1,284/3,000', delay: '-1.2s' },
            { q: 'woodblock_print', kind: 'Sub', n: '12/40', delay: '-2.4s' },
          ].map((d) => (
            <div class="dl-card">
              <span class="site">S</span>
              <span class="dl-text">
                <span class="dl-row">
                  <b>{d.q}</b>
                  <span class:list={['kind', { sub: d.kind === 'Sub' }]}>{d.kind}</span>
                </span>
                <span class="dl-meta">{d.n}</span>
                <span class="bar">
                  <span style={`animation-delay:${d.delay}`} />
                </span>
              </span>
            </div>
          ))
        }
      </div>
      <div class="dl-new">
        {
          newFiles.map((src, i) => (
            <i style={`--i:${i}`}>
              <Image src={src} alt="" width={120} height={120} fit="cover" layout="fixed" />
              <span>NEW</span>
            </i>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Comics -->
  <section class="wrap feature flip">
    <div class="copy" data-reveal>
      <p class="eyebrow"><Icon name="book" size={15} /> Comics</p>
      <h2>Galleries become comics.</h2>
      <p class="lead">
        A gallery downloads as one comic with its own reader: swipe or scroll like a webtoon, pick up where you left off, sort them into collections, and
        browse a gallery site before downloading anything.
      </p>
    </div>
    <div class="shot" data-reveal style="--i:1">
      <Frame src={reader} alt="The comic reader: a page of Little Nemo in Slumberland, its title and page number at the top, a slider at the bottom" />
    </div>
  </section>

  <!-- Phone -->
  <section class="phone-sec">
    <div class="wrap">
      <div class="center" data-reveal>
        <p class="eyebrow"><Icon name="phone" size={15} /> On your phone</p>
        <h2>Made for the phone first. Just as good on a desktop.</h2>
        <p class="lead">
          Add Vitrine to your home screen and it's an app: gestures that feel native, inline video, push notifications, and nothing that's only been tested
          on a big screen.
        </p>
      </div>
      <div class="phones">
        <Frame src={phoneSearch} kind="phone" alt="On a phone: a search with chips over a grid of woodblock prints" class="p1" />
        <Frame src={phoneVideo} kind="phone" alt="On a phone: a clip playing in the viewer, with its controls" class="p2" />
        <Frame src={phoneComics} kind="phone" alt="On a phone: the Comics page" class="p3" />
      </div>
    </div>
  </section>

  <!-- Plugins -->
  <section class="wrap plugins">
    <div class="glow plug-card" data-reveal>
      <div class="plug-copy">
        <p class="eyebrow"><Icon name="puzzle" size={15} /> Plugins</p>
        <h2>Any site, with a plugin.</h2>
        <p class="lead">
          The downloader learns a site from a small plugin file. Install and update them from the list in Settings, or from a file. Vitrine speaks booru-style
          image boards (Gelbooru, Danbooru, Shimmie), gallery sites and Mastodon, and Safebooru comes built in.
        </p>
        <p>
          Write your own: a plugin is a short YAML file, no code. Plugins for more sites, some of them adult, are in the <a href={PLUGINS_REPO}
            >plugins repository</a
          >.
        </p>
      </div>
      <pre class="yaml" aria-label="A plugin file: Safebooru's"><code><span class="k">id</span>: safebooru
<span class="k">name</span>: Safebooru
<span class="k">engine</span>: gelbooru-v02
<span class="k">base</span>: https://safebooru.org
<span class="k">domains</span>: [safebooru.org]
<span class="k">limits</span>: &#123;requests_per_sec: 1, connections: 2&#125;
<span class="k">search</span>: &#123;per_page: 100&#125;</code></pre>
    </div>
  </section>

  <!-- More -->
  <section class="wrap more">
    <h2 class="center" data-reveal>And the rest of it.</h2>
    <div class="more-grid">
      {
        more.map((m, i) => (
          <div class="glow tile" data-reveal style={`--i:${i % 4}`}>
            <span class="tile-icon">
              <Icon name={m.icon} size={20} />
            </span>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Install -->
  <section id="install" class="wrap install">
    <div class="center" data-reveal>
      <p class="eyebrow"><Icon name="download" size={15} /> Install</p>
      <h2>Up and running in a minute.</h2>
      {release.version && <p class="lead">The latest version is {release.version}.</p>}
    </div>
    <div class="ways">
      <div class="glow way" data-reveal style="--i:0">
        <span class="tile-icon"><Icon name="desktop" size={20} /></span>
        <h3>Windows</h3>
        <p>The installer brings everything with it, asks where to keep your library, and puts Vitrine by the clock. No administrator needed.</p>
        <a class="btn" href={windows}><Icon name="download" size={18} /> Download for Windows</a>
        <p class="small">Windows may warn about an unknown publisher: More info, then Run anyway.</p>
      </div>
      <div class="glow way" data-reveal style="--i:1">
        <span class="tile-icon"><Icon name="layers" size={20} /></span>
        <h3>Docker</h3>
        <p>For a home server or NAS. Save this as <code>compose.yaml</code>, then run <code>docker compose up -d</code>.</p>
        <div class="code">
          <button class="copy-btn" type="button" aria-label="Copy"><Icon name="copy" size={15} /></button>
          <pre><code>services:
  vitrine:
    image: ghcr.io/usevitrine/vitrine:latest
    user: "1000:1000"
    ports:
      - 8080:8080
    environment:
      - VITRINE_FILES_DIR=/files
    volumes:
      - ./data:/data
      - ./files:/files
    restart: unless-stopped</code></pre>
        </div>
        <p class="small"><a href={`${REPO}/blob/main/compose.example.yaml`}>The full example</a> adds updates from the app and Cloudflare help.</p>
      </div>
      <div class="glow way" data-reveal style="--i:2">
        <span class="tile-icon"><Icon name="terminal" size={20} /></span>
        <h3>Linux and macOS</h3>
        <p>One program for amd64 and arm64. Put it on your PATH and run it; ffmpeg makes the thumbnails.</p>
        <div class="code">
          <pre><code>vitrine serve</code></pre>
        </div>
        <a class="btn quiet" href={RELEASES}><Icon name="external" size={18} /> All downloads</a>
      </div>
    </div>
    <p class="aside center" data-reveal>Then open http://localhost:8080 and make your account. The first one to visit gets it, so be quick.</p>
  </section>

  <!-- FAQ -->
  <section id="faq" class="wrap faq">
    <h2 class="center" data-reveal>Questions</h2>
    <div class="qs">
      {
        faqs.map((f, i) => (
          <details class="glow q" data-reveal style={`--i:${i % 3}`}>
            <summary>
              <span>{f.q}</span>
              <i aria-hidden="true" />
            </summary>
            <div class="ans">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
    <div class="ask" data-reveal>
      <p>Something else?</p>
      <Email><Icon name="mail" size={16} /></Email>
      <a class="btn quiet" href={`${REPO}/issues`}><Icon name="fork" size={16} /> Ask on GitHub</a>
    </div>
  </section>
</Base>

<script>
  // Count up to a number as it scrolls into view.
  const fmt = new Intl.NumberFormat('en-US');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      io.unobserve(e.target);
      const el = e.target as HTMLElement;
      const to = Number(el.dataset.count);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
      const start = performance.now();
      const step = (now: number) => {
        const k = Math.min(1, (now - start) / 1400);
        el.textContent = fmt.format(Math.round(to * (1 - Math.pow(1 - k, 4))));
        if (k < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
  });
  for (const el of document.querySelectorAll('[data-count]')) io.observe(el);
  // Copy the compose file.
  for (const b of document.querySelectorAll<HTMLButtonElement>('.code .copy-btn')) {
    b.addEventListener('click', async () => {
      await navigator.clipboard?.writeText(b.parentElement!.querySelector('code')!.textContent ?? '');
      b.classList.add('done');
      setTimeout(() => b.classList.remove('done'), 1400);
    });
  }
  // A question opens and closes with its height (details has no transition of its own).
  const ease = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
  for (const d of document.querySelectorAll<HTMLDetailsElement>('details.q')) {
    const ans = d.querySelector<HTMLElement>('.ans')!;
    d.querySelector('summary')!.addEventListener('click', (e) => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      e.preventDefault();
      if (d.classList.contains('shut')) return;
      if (d.open) {
        d.classList.add('shut');
        const a = ans.animate([{ height: `${ans.offsetHeight}px`, opacity: 1 }, { height: '0px', opacity: 0 }], { duration: 260, easing: ease });
        a.onfinish = () => {
          d.open = false;
          d.classList.remove('shut');
        };
      } else {
        d.open = true;
        ans.animate([{ height: '0px', opacity: 0 }, { height: `${ans.offsetHeight}px`, opacity: 1 }], { duration: 320, easing: ease });
      }
    });
  }
</script>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    padding: clamp(56px, 9vw, 110px) 0 0;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto;
    height: 900px;
    background:
      radial-gradient(600px 380px at 30% 30%, color-mix(in srgb, var(--mauve) 22%, transparent), transparent 70%),
      radial-gradient(520px 340px at 75% 20%, color-mix(in srgb, var(--pink) 12%, transparent), transparent 70%);
    pointer-events: none;
  }
  .wall {
    position: absolute;
    inset: 0 -4% auto;
    height: 760px;
    display: grid;
    gap: 10px;
    align-content: start;
    opacity: 0.32;
    mask-image: radial-gradient(70% 60% at 50% 30%, #000 10%, transparent 75%);
    pointer-events: none;
  }
  .wall-row {
    display: flex;
    gap: 10px;
  }
  .wall i {
    flex-basis: 0;
    min-width: 0;
    border-radius: 10px;
    background: linear-gradient(140deg, color-mix(in srgb, var(--a) 55%, var(--base)), color-mix(in srgb, var(--b) 35%, var(--crust)));
    animation: settle 1.4s var(--ease) both;
    animation-delay: var(--d);
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: translate(var(--x), var(--y)) rotate(var(--r)) scale(0.6);
    }
  }
  .hero-text {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 22px;
  }
  .hero h1 {
    font-size: clamp(40px, 7vw, 82px);
  }
  .hero .lead {
    max-width: 640px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 6px;
  }
  .rise {
    animation: rise 0.9s var(--ease) both;
    animation-delay: calc(200ms + var(--i) * 110ms);
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  .hero-shots {
    position: relative;
    margin-top: clamp(48px, 7vw, 80px);
    padding-bottom: 40px;
  }
  .hero-shots::before {
    content: '';
    position: absolute;
    inset: 10% 8% 0;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--mauve) 35%, transparent), transparent);
    filter: blur(40px);
  }
  .hero-shots :global(.hero-laptop) {
    position: relative;
    max-width: 1060px;
    margin: 0 auto;
    animation: lift 1.3s var(--ease) both 0.7s;
  }
  /* (off the hero's bottom, which crops: its bezel was cut) */
  .hero-shots :global(.hero-phone) {
    position: absolute;
    right: max(var(--gutter), calc(50% - 560px));
    bottom: clamp(10px, 2vw, 24px);
    width: clamp(110px, 20vw, 250px);
    animation: lift-phone 1.3s var(--ease) both 1.05s;
  }
  @keyframes lift {
    from {
      opacity: 0;
      transform: translateY(90px) scale(0.94);
    }
  }
  @keyframes lift-phone {
    from {
      opacity: 0;
      transform: translate(40px, 80px) rotate(6deg);
    }
  }

  /* ---- Numbers ---- */
  .numbers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: clamp(60px, 9vw, 110px);
    text-align: center;
  }
  .num {
    display: grid;
    gap: 6px;
  }
  .num strong {
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 800;
    letter-spacing: -0.03em;
