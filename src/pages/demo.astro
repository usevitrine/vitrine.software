---
// The demo: Vitrine's own web app (the submodule's, built in demo mode - its search runs this program's index as
// WebAssembly) with a library of public-domain art and Blender open-movie clips, in a frame. A short text above it
// for people and search engines; on a phone the app is better full screen, so it says so.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const title = 'Try Vitrine - a live demo in your browser';
const description =
  "Try Vitrine's media library in your browser: search with tags, sort and filter a library of public-domain art and open-movie clips, open the viewer and the details with their tags and sources, favorite and tag things. Nothing to install, nothing saved.";
---

<Base title={title} description={description}>
  <section class="wrap demo">
    <div class="intro">
      <div>
        <p class="eyebrow"><Icon name="play" size={15} /> Demo</p>
        <h1>Vitrine, right here in your browser.</h1>
        <p class="lead">
          The real media screen, with 296 public-domain artworks and 24 clips from the Blender open movies. Search with tags, open the viewer and the
          details, tag and favorite things. Your changes stay in this tab: reload and it's fresh again.
        </p>
      </div>
      <a class="btn quiet full" href="/demo/app/"><Icon name="external" size={18} /> Full screen</a>
    </div>
    <div class="frame glow">
      <iframe src="/demo/app/" title="The Vitrine demo: the media screen" allow="fullscreen" loading="eager"></iframe>
    </div>
    <p class="aside">Try <code>sintel</code>, <code>-painting</code>, <code>system:type=video</code> or <code>creator:vincent_van_gogh</code>. Go on, delete something. There's undo.</p>
  </section>
</Base>

<style>
  .demo {
    display: grid;
    gap: 22px;
    padding-top: clamp(28px, 5vw, 56px);
  }
  .intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .intro > div {
    display: grid;
    gap: 12px;
    max-width: 760px;
  }
  h1 {
    font-size: clamp(30px, 4.4vw, 52px);
  }
  .full {
    flex: none;
  }
  /* The app fills what's left of the window under the header (its own screen, at least a phone's height). */
  .frame {
    padding: 6px;
    border-radius: 18px;
  }
  iframe {
    display: block;
    width: 100%;
    height: max(560px, calc(100dvh - 120px));
    border: 0;
    border-radius: 13px;
    background: var(--crust);
  }
  .aside code {
    font-style: normal;
    font-size: 0.9em;
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--surface0);
    color: var(--text);
  }
  @media (max-width: 700px) {
    .intro {
      flex-direction: column;
      align-items: stretch;
    }
    .full {
      justify-content: center;
    }
    iframe {
      height: calc(100dvh - 90px);
    }
  }
</style>
