---
// A screenshot in a device: a laptop (a browser window on a lid, a base under it) or a phone (rounded, a dynamic
// island). The picture as AVIF/WebP in the sizes it's shown at, its width and height set (nothing jumps as it loads).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  kind?: 'laptop' | 'phone';
  eager?: boolean; // the hero's: loaded first
  class?: string;
}
const { src, alt, kind = 'laptop', eager = false, class: cls } = Astro.props;
const sizes = kind === 'phone' ? '(min-width: 900px) 300px, 45vw' : '(min-width: 1240px) 1100px, 92vw';
---

<figure class:list={['frame', kind, cls]}>
  <div class="screen">
    {kind === 'laptop' && (
      <div class="chrome" aria-hidden="true">
        <i /><i /><i />
        <span class="url">vitrine.local</span>
      </div>
    )}
    {
      kind === 'phone' && (
        <div class="status" aria-hidden="true">
          <span class="time">9:41</span>
          <span class="island" />
          <span class="icons">
            <svg viewBox="0 0 18 12">
              <rect x="0" y="8" width="3" height="4" rx="1" />
              <rect x="5" y="5.5" width="3" height="6.5" rx="1" />
              <rect x="10" y="3" width="3" height="9" rx="1" />
              <rect x="15" y="0" width="3" height="12" rx="1" />
            </svg>
            <svg viewBox="0 0 16 12">
              <path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0z" />
              <path d="M3.4 6.8a6.5 6.5 0 0 1 9.2 0l-1.4 1.4a4.5 4.5 0 0 0-6.4 0z" />
              <path d="M1.2 4.6a9.6 9.6 0 0 1 13.6 0l-1.4 1.4a7.6 7.6 0 0 0-10.8 0z" />
            </svg>
            <svg viewBox="0 0 27 12">
              <rect x="0.5" y="0.5" width="23" height="11" rx="3.5" fill="none" stroke="currentColor" opacity=".45" />
              <rect x="2.5" y="2.5" width="19" height="7" rx="2" />
              <rect x="25" y="4" width="1.6" height="4" rx=".8" opacity=".45" />
            </svg>
          </span>
        </div>
      )
    }
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      sizes={sizes}
      widths={kind === 'phone' ? [300, 450, 600, 900] : [640, 960, 1280, 1600, 1920]}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      layout="full-width"
    />
  </div>
  {kind === 'laptop' && <div class="base" aria-hidden="true" />}
</figure>

<script>
  // The phones' status bars show the visitor's own time, as a phone writes it: no AM/PM, the region's 12- or 24-hour
  // clock (the page as built says 9:41).
  const clock = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
  const show = () => {
    const now = clock.formatToParts(new Date()).filter((p) => p.type !== 'dayPeriod').map((p) => p.value).join('').trim();
    for (const el of document.querySelectorAll('.frame.phone .time')) el.textContent = now;
  };
  show();
  // At each new minute.
  setTimeout(() => {
    show();
    setInterval(show, 60_000);
  }, 60_000 - (Date.now() % 60_000));
</script>

<style>
  /* Every size in the frame is a share of its width (container units: cqw = 1% of it), so a small laptop or phone -
     the hero on a phone - looks like a big one shrunk, not one with a thick bar and round corners (the user: on a
     phone the browser bar was too big, the phone too round). --bz: the bezel. */
  .frame {
    margin: 0;
    position: relative;
    container-type: inline-size;
  }
  .screen {
    position: relative;
    overflow: hidden;
    background: var(--base);
  }
  .screen :global(img) {
    width: 100%;
    height: auto;
  }
  .laptop {
    --bz: max(3px, 0.6cqw);
  }
  .laptop .screen {
    border-radius: max(5px, 1.3cqw) max(5px, 1.3cqw) max(2px, 0.4cqw) max(2px, 0.4cqw);
    border: 1px solid var(--surface1);
    box-shadow:
      0 0 0 var(--bz) #0b0b12,
      0 0 0 calc(var(--bz) + 1px) var(--surface0),
      0 4cqw 8cqw -3cqw rgb(0 0 0 / 0.8);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 0.55cqw;
    height: max(12px, 2.6cqw);
    padding: 0 1.1cqw;
    background: var(--mantle);
    border-bottom: 1px solid var(--surface0);
  }
  .chrome i {
    width: max(4px, 0.9cqw);
    height: max(4px, 0.9cqw);
    border-radius: 50%;
    background: var(--surface1);
  }
  .chrome i:nth-child(1) {
    background: var(--red);
  }
  .chrome i:nth-child(2) {
    background: var(--yellow);
  }
  .chrome i:nth-child(3) {
    background: var(--green);
  }
  .url {
    margin: 0 auto;
    padding: 0.15cqw 2.6cqw;
    border-radius: 0.55cqw;
    background: var(--base);
    font-size: max(6px, 1cqw);
    line-height: 1.4;
    color: var(--overlay1);
    transform: translateX(-2cqw);
  }
  /* (below the screen's bezel - a ring drawn outside it - not over its bottom edge) */
  .base {
    height: max(5px, 1.3cqw);
    margin: calc(var(--bz) + 1px) max(-5%, -14px) 0;
    border-radius: 2px 2px max(5px, 1.3cqw) max(5px, 1.3cqw);
    background: linear-gradient(180deg, #2a2b3c, #15151f);
    box-shadow: 0 1.7cqw 2.8cqw -1.1cqw rgb(0 0 0 / 0.7);
  }
  .base::after {
    content: '';
    display: block;
    width: 16%;
    height: 40%;
    margin: 0 auto;
    border-radius: 0 0 0.75cqw 0.75cqw;
    background: #0d0d15;
  }
  /* A phone: slightly rounded, a thin bezel, and a status bar of its own above the screenshot (the camera sits in
     it, never over the page). */
  .phone {
    --bz: max(2px, 1.8cqw);
  }
  .phone .screen {
    border-radius: 6.5cqw;
    border: 1px solid var(--surface1);
    background: var(--crust);
    box-shadow:
      0 0 0 var(--bz) #0b0b12,
      0 0 0 calc(var(--bz) + 1px) var(--surface0),
      0 14cqw 25cqw -11cqw rgb(0 0 0 / 0.85);
  }
  .status {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 11cqw;
    padding: 0 6cqw;
    color: var(--text);
    background: var(--crust);
  }
  .time {
    font-size: 4.2cqw;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .island {
    width: 26cqw;
    height: 7cqw;
    border-radius: 999px;
    background: #000;
    box-shadow: inset 0 0 0 1px #1a1a24;
  }
  .icons {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.4cqw;
  }
  .icons svg {
    height: 3.2cqw;
    width: auto;
    fill: currentColor;
  }
</style>
