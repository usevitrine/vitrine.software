---
// A screenshot in a device: a laptop (a browser window on a lid, a base under it) or a phone (rounded, a dynamic
// island). The picture as AVIF/WebP in the sizes it's shown at, its width and height set (nothing jumps as it loads).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  kind?: 'laptop' | 'phone';
  eager?: boolean; // the hero's: loaded first
  class?: string;
}
const { src, alt, kind = 'laptop', eager = false, class: cls } = Astro.props;
const sizes = kind === 'phone' ? '(min-width: 900px) 300px, 45vw' : '(min-width: 1240px) 1100px, 92vw';
---

<figure class:list={['frame', kind, cls]}>
  <div class="screen">
    {kind === 'laptop' && (
      <div class="chrome" aria-hidden="true">
        <i /><i /><i />
        <span class="url">vitrine.local</span>
      </div>
    )}
    {
      kind === 'phone' && (
        <div class="status" aria-hidden="true">
          <span class="time">9:41</span>
          <span class="island" />
          <span class="icons">
            <svg viewBox="0 0 18 12">
              <rect x="0" y="8" width="3" height="4" rx="1" />
              <rect x="5" y="5.5" width="3" height="6.5" rx="1" />
              <rect x="10" y="3" width="3" height="9" rx="1" />
              <rect x="15" y="0" width="3" height="12" rx="1" />
            </svg>
            <svg viewBox="0 0 16 12">
              <path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0z" />
              <path d="M3.4 6.8a6.5 6.5 0 0 1 9.2 0l-1.4 1.4a4.5 4.5 0 0 0-6.4 0z" />
              <path d="M1.2 4.6a9.6 9.6 0 0 1 13.6 0l-1.4 1.4a7.6 7.6 0 0 0-10.8 0z" />
            </svg>
            <svg viewBox="0 0 27 12">
              <rect x="0.5" y="0.5" width="23" height="11" rx="3.5" fill="none" stroke="currentColor" opacity=".45" />
              <rect x="2.5" y="2.5" width="19" height="7" rx="2" />
              <rect x="25" y="4" width="1.6" height="4" rx=".8" opacity=".45" />
            </svg>
          </span>
        </div>
      )
    }
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      sizes={sizes}
      widths={kind === 'phone' ? [300, 450, 600, 900] : [640, 960, 1280, 1600, 1920]}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      layout="full-width"
    />
  </div>
  {kind === 'laptop' && <div class="base" aria-hidden="true" />}
</figure>

<style>
  .frame {
    margin: 0;
    position: relative;
  }
  .screen {
    position: relative;
    overflow: hidden;
    background: var(--base);
  }
  .screen :global(img) {
    width: 100%;
    height: auto;
  }
  .laptop .screen {
    border-radius: 14px 14px 4px 4px;
    border: 1px solid var(--surface1);
    box-shadow:
      0 0 0 6px #0b0b12,
      0 0 0 7px var(--surface0),
      0 40px 80px -30px rgb(0 0 0 / 0.8);
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    background: var(--mantle);
    border-bottom: 1px solid var(--surface0);
  }
  .chrome i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--surface1);
  }
  .chrome i:nth-child(1) {
    background: var(--red);
  }
  .chrome i:nth-child(2) {
    background: var(--yellow);
  }
  .chrome i:nth-child(3) {
    background: var(--green);
  }
  .url {
    margin: 0 auto;
    padding: 2px 28px;
    border-radius: 6px;
    background: var(--base);
    font-size: 11px;
    color: var(--overlay1);
    transform: translateX(-21px);
  }
  .base {
    height: 14px;
    margin: 0 max(-5%, -14px);
    border-radius: 2px 2px 14px 14px;
    background: linear-gradient(180deg, #2a2b3c, #15151f);
    box-shadow: 0 18px 30px -12px rgb(0 0 0 / 0.7);
  }
  .base::after {
    content: '';
    display: block;
    width: 16%;
    height: 5px;
    margin: 0 auto;
    border-radius: 0 0 8px 8px;
    background: #0d0d15;
  }
  /* A phone: slightly rounded, a thin bezel, and a status bar of its own above the screenshot (the camera sits in
     it, never over the page). Sized by the phone's width (container units), so it's the same at any size. */
  .phone .screen {
    container-type: inline-size;
    border-radius: 18px;
    border: 1px solid var(--surface1);
    background: var(--crust);
    box-shadow:
      0 0 0 5px #0b0b12,
      0 0 0 6px var(--surface0),
      0 40px 70px -30px rgb(0 0 0 / 0.85);
  }
  .status {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 11cqw;
    padding: 0 6cqw;
    color: var(--text);
    background: var(--crust);
  }
  .time {
    font-size: 4.2cqw;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .island {
    width: 26cqw;
    height: 7cqw;
    border-radius: 999px;
    background: #000;
    box-shadow: inset 0 0 0 1px #1a1a24;
  }
  .icons {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.4cqw;
  }
  .icons svg {
    height: 3.2cqw;
    width: auto;
    fill: currentColor;
  }
</style>
